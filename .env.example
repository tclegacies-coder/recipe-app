# Supabase — Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Calorie API — calorieapi.com (free tier: 1,000 requests/month, no card)
VITE_CALORIE_API_KEY=

# USDA FoodData Central — fdc.nal.usda.gov/api-key-signup.html
VITE_USDA_API_KEY=

# Spoonacular — spoonacular.com/food-api/console (Phase 2: recipe curation)
VITE_SPOONACULAR_API_KEY=

# Edamam Recipe Search API — developer.edamam.com (second recipe source,
# used to widen results when Spoonacular's filters are narrow)
VITE_EDAMAM_APP_ID=
VITE_EDAMAM_APP_KEY=
# REQUIRED — set this to your actual Edamam account USERNAME (the login
# name on your Edamam dashboard, found under your account profile) — NOT
# your app ID and NOT your app key. Allowed characters: a-z/A-Z/0-9/-/_/.,
# max 30 chars. Leaving this blank or using the wrong value is a common
# cause of "Edamam rejected the request" 401/403 errors.
VITE_EDAMAM_ACCOUNT_USER=

# Open Food Facts needs no key — it's queried directly.
